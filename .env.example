# ============================================================================
# VARIAVEIS DE AMBIENTE OBRIGATORIAS
#
# O arquivo .env fica no .gitignore e NUNCA vai para o GitHub. Por isso, cada
# ambiente de deploy precisa ter essas variaveis configuradas no seu painel:
#
#   - Render:  Dashboard > seu servico > Environment > Add Environment Variable
#   - Local:   copie este arquivo para .env e preencha os valores
#
# Sem elas o app sobe com o banco VAZIO, sem avisar.
# ============================================================================

# --- Supabase (obrigatorio) -------------------------------------------------
# Onde o banco de producao vive. O app guarda o SQLite inteiro como um
# snapshot comprimido na tabela system_snapshots.
# Valorize com o Transaction Pooler do Supabase:
#   Settings > Database > Connection string > URI (modo Session/Transaction)
SQL_HOST="aws-0-sa-east-1.pooler.supabase.com"
SQL_PORT="6543"
SQL_USER="postgres.SEU_PROJETO"
SQL_PASSWORD="SUA_SENHA"
SQL_DB_NAME="postgres"

# --- Frontend (obrigatorio em deploy) ---------------------------------------
# URL publica do backend. No Render e a propria URL do servico, sem barra final.
# Sem essa variavel o frontend buildado tenta chamar /api no mesmo dominio do
# app e falha, porque o backend sobe em /api do Express, nao do HTML estatico.
VITE_API_URL="https://seu-servico.onrender.com"

# --- Opcionais --------------------------------------------------------------
# Chave do Gemini para recursos de IA.
GEMINI_API_KEY=""

# URL publica do app, usada em links auto-referentes e callbacks de OAuth.
APP_URL=""