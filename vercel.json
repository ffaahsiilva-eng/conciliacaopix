{
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm",
      "memory": 512,
      "maxDuration": 15
    },
    "api/**/*": {
      "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm",
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
